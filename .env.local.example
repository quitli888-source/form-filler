# form-filler LLM 内核配置模板 —— 复制为 .env.local 后填入真实 key
# .env.local 已被 .gitignore 排除；本模板文件可安全提交（不含 key）。

# step-5-preview 内核（OpenAI 兼容 chat-completions 协议）
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.stepfun.com/v1
LLM_API_KEY=<YOUR_LLM_API_KEY>
LLM_MODEL_NAME=step-5-preview
LLM_REFLECT_RETRIES=2
